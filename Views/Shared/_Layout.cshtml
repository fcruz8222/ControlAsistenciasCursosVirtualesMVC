<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title - Control de Asistencia</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
</head>
<body>

    @{
        var rol = Session["ROLE"] == null ? "" : Session["ROLE"].ToString();
        var usuario = Session["USER"] == null ? "" : Session["USER"].ToString();
        var controller = ViewContext.RouteData.Values["controller"].ToString();
    }

    <header class="app-header">
        <div class="header-main">
            <div class="brand-area">
                <div class="brand-icon">✓</div>
                <div>
                    <div class="brand-title">Control de Asistencia</div>
                    <div class="brand-subtitle">Cursos Virtuales</div>
                </div>
            </div>

            <div class="user-area">
                @if (!string.IsNullOrWhiteSpace(usuario))
                {
                    <span class="user-pill">👤 @usuario</span>
                    <a href="@Url.Action("Logout", "Auth")" class="logout-link">Cerrar sesión</a>
                }
                else
                {
                    <span class="user-pill">No autenticado</span>
                }
            </div>
        </div>

        <nav class="nav-menu">
            <a class="@(controller == "Home" ? "active" : "")"
               href="@Url.Action("Index", "Home")">Inicio</a>

            @if (rol == "Admin")
            {
                <a class="@(controller == "Usuarios" ? "active" : "")"
                   href="@Url.Action("Index", "Usuarios")">Usuarios</a>

                <a class="@(controller == "Maestros" ? "active" : "")"
                   href="@Url.Action("Index", "Maestros")">Maestros</a>
            }

            @if (rol == "Admin" || rol == "Maestro")
            {
                <a class="@(controller == "Cursos" ? "active" : "")"
                   href="@Url.Action("Index", "Cursos")">Cursos</a>
            }

            @if (rol == "Admin" || rol == "Maestro" || rol == "Estudiante")
            {
                <a class="@(controller == "Asistencias" ? "active" : "")"
                   href="@Url.Action("Index", "Asistencias")">Registrar Asistencia</a>

                <a class="@(controller == "Estadisticas" ? "active" : "")"
                   href="@Url.Action("Index", "Estadisticas")">Estadísticas</a>
            }

            @if (rol == "Admin" || rol == "Maestro")
            {
                <a class="@(controller == "Alumnos" ? "active" : "")"
                   href="@Url.Action("Index", "Alumnos")">Estudiantes</a>

                <a class="@(controller == "CursoEstudiantes" ? "active" : "")"
                   href="@Url.Action("Index", "CursoEstudiantes")">Asignar Cursos</a>
            }
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.6.0.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';
            var warning = '@TempData["Warning"]';

            if (success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Éxito',
                    text: success
                });
            }

            if (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error
                });
            }

            if (warning) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Aviso',
                    text: warning
                });
            }
        });
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>