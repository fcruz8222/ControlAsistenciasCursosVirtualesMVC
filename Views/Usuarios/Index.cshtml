@model ControlAsistenciasCursosVirtuales.Models.UsuariosIndexViewModel

@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card" style="max-width:1000px;">
    <h2 class="card-title">Administración de Usuarios</h2>

    <div class="toolbar">
        <div class="toolbar-left">
            <button type="button" class="btn btn-sm" onclick="abrirUsuarioModalNuevo()">
                ➕ Crear Usuario
            </button>
        </div>
    </div>

        <div style="margin-top:16px;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Usuarios)
                    {
                        <tr>
                            <td>@item.CodigoUsuario</td>
                            <td>@item.NombreUsuario</td>
                            <td>@item.Rol</td>
                            <td>
                                <span class="badge @(item.Activo ? "activo" : "inactivo")">
                                    @(item.Activo ? "ACTIVO" : "INACTIVO")
                                </span>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-primary"
                                   href="@Url.Action("Editar", "Usuarios", new { id = item.CodigoUsuario })">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

<div id="usuarioModal" class="modal-overlay">
    <div class="modal-box">

        <div class="modal-header">
            <span class="modal-title">
                @(string.IsNullOrWhiteSpace(Model.Usuario.UsuarioOriginal)
                    ? "Crear Usuario"
                    : "Editar Usuario (" + Model.Usuario.UsuarioOriginal + ")")
            </span>

            <span class="modal-close" onclick="cancelarUsuarioModal()">×</span>
        </div>

        @using (Html.BeginForm("Guardar", "Usuarios", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.Usuario.UsuarioOriginal)

            @Html.ValidationSummary(true, "", new { @class = "error" })

            <div class="field">
                <label>Código de Usuario</label>
                @Html.TextBoxFor(m => m.Usuario.CodigoUsuario)
                @Html.ValidationMessageFor(m => m.Usuario.CodigoUsuario, "", new { @class = "error" })
            </div>

            <div class="field">
                <label>Nombre</label>
                @Html.TextBoxFor(m => m.Usuario.NombreUsuario)
                @Html.ValidationMessageFor(m => m.Usuario.NombreUsuario, "", new { @class = "error" })
            </div>

            <div class="field">
                <label>Contraseña</label>
                @Html.PasswordFor(m => m.Usuario.Password)
                @Html.ValidationMessageFor(m => m.Usuario.Password, "", new { @class = "error" })

                @if (!string.IsNullOrWhiteSpace(Model.Usuario.UsuarioOriginal))
                {
                    <small>Dejar vacío si no desea cambiar la contraseña.</small>
                }
            </div>

            <div class="field">
                <label>Rol</label>
                @Html.DropDownListFor(m => m.Usuario.Rol, Model.Usuario.Roles)
                @Html.ValidationMessageFor(m => m.Usuario.Rol, "", new { @class = "error" })
            </div>

            <div class="field">
                <label>
                    @Html.CheckBoxFor(m => m.Usuario.Activo)
                    Activo
                </label>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn btn-sm">Guardar</button>
                <button type="button" class="btn btn-sm btn-secondary" onclick="cancelarUsuarioModal()">Cancelar</button>
            </div>
        }
    </div>
</div>

<script>
    function abrirUsuarioModal() {
        document.getElementById("usuarioModal").style.display = "flex";
    }

    function cerrarUsuarioModal() {
        document.getElementById("usuarioModal").style.display = "none";
    }

    function abrirUsuarioModalNuevo() {
        abrirUsuarioModal();
    }

    function cancelarUsuarioModal() {
        window.location.href = '@Url.Action("Index", "Usuarios")';
    }

    @if (ViewBag.AbrirModal == true)
    {
        <text>
            abrirUsuarioModal();
        </text>
    }
</script>